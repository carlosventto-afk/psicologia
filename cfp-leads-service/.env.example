# IMPORTANTE: rodar com exatamente 1 réplica — não há lock de concorrência no
# código. Duas réplicas fariam scan duplicado, corrida no leads_cfp_scan_state e
# dobrariam a taxa de requisições contra o site do CFP.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
BATCH_SIZE=3000
RUN_INTERVAL_HOURS=24
DELAY_MIN_MS=2500
DELAY_MAX_MS=5000
